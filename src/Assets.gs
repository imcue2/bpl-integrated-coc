/**
 * Static assets embedded directly in source (Apps Script has no local
 * filesystem access at runtime) — currently just the BPL logo, used by
 * the daily email digest (inline in the HTML body + on the PDF cover).
 */
function getLogoBlob_() {
  return Utilities.newBlob(Utilities.base64Decode(BPL_LOGO_BASE64_), 'image/png', 'bpl-logo.png');
}

var BPL_LOGO_BASE64_ = '';
